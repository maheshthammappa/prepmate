# ─────────────────────────────────────────────────
#  PrepMate – Root .gitignore
# ─────────────────────────────────────────────────

# ── OS / System ───────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ── IDE / Editor ──────────────────────────────────
.idea/
*.iml
*.iws
*.ipr
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
*.swo
.project
.classpath
.factorypath
.settings/
.springBeans
.sts4-cache/
.apt_generated/
nbproject/private/
nbbuild/
nbdist/
.nb-gradle/

# ── Secrets / Environment ─────────────────────────
.env
.env.local
.env.*.local
*.properties.local
application-local.properties
application-secret.properties
secrets.yml
secrets.yaml

# ── Logs ──────────────────────────────────────────
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── Temp / Cache ──────────────────────────────────
*.tmp
*.temp
.cache/
.parcel-cache/
