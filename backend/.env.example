# =============================================================================
# PrepMate Backend - Environment Variables Configuration
# =============================================================================
# Copy this file to .env or configure these variables in your environment / hosting provider.
# For local development with Spring Boot, these can be set in your OS environment or run configuration.

# Application Profile & Frontend URL
SPRING_PROFILES_ACTIVE=local
FRONTEND_URL=http://localhost:5173

# Google Gemini AI Configuration
# Gemini REST API endpoint and API Key for Question Generation, Evaluation, Embeddings, and Mentor Chat
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent
GEMINI_API_KEY=your_gemini_api_key_here

# Groq Cloud API Configuration
# Ultra-fast Whisper API for real-time speech-to-text audio transcription during interviews
GROQ_API_KEY=your_groq_api_key_here

# Pinecone Vector Database Configuration
# Used for semantic question deduplication & vector indexing of mastered questions (768-dim)
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_HOST=https://prepmate-questions-xxxx.svc.aped-4627-b74a.pinecone.io

# PostgreSQL Database Configuration (Neon / Supabase / Local PostgreSQL)
DATABASE_URL=jdbc:postgresql://your-host-pooler.neon.tech:5432/neondb?sslmode=require
DATABASE_USERNAME=your_database_username
DATABASE_PASSWORD=your_database_password

# JWT Security Configuration
# Must be a secure, random secret key with at least 256-bits (32+ characters)
JWT_SECRET=your_super_secret_jwt_key_with_at_least_256_bits_for_security_12345
